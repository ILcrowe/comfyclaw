# ComfyClaw configuration template.
# Copy this file to `.env` and edit the values you need.
#
# Configuration precedence:
#   1. CLI flags
#   2. Environment variables loaded from `.env`
#   3. Built-in defaults

# ---------------------------------------------------------------------------
# ComfyUI connection
# ---------------------------------------------------------------------------

# HTTP address of a running ComfyUI server.
COMFYUI_ADDR=127.0.0.1:8188

# Local ComfyUI install path, used by `uv run comfyclaw install-node` and
# `uv run comfyclaw models ...`.
# COMFYUI_DIR=~/Documents/ComfyUI

# WebSocket port used by the ComfyUI browser plugin to talk to `serve`.
COMFYCLAW_SYNC_PORT=8765

# ---------------------------------------------------------------------------
# LLM provider credentials
# ---------------------------------------------------------------------------

# Set the key matching COMFYCLAW_MODEL / COMFYCLAW_VERIFIER_MODEL.
# Leave these blank if you use Ollama or a signed-in CLI backend.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# AZURE_API_KEY=...
# AZURE_API_BASE=https://your-resource.openai.azure.com

# Optional OpenAI-compatible endpoint for local servers such as vLLM.
# Generate/check these values with:
#   uv run comfyclaw configure-local-llm --provider vllm --model Qwen/Qwen3.6-27B \
#     --api-base http://127.0.0.1:18000/v1 --check --write-env
# COMFYCLAW_API_BASE=http://127.0.0.1:18000/v1

# ---------------------------------------------------------------------------
# Agent and verifier
# ---------------------------------------------------------------------------

# Agent backend: litellm, claude-code, codex, gemini-cli, or grok-cli.
COMFYCLAW_AGENT_BACKEND=litellm

# LiteLLM model string for the agent.
COMFYCLAW_MODEL=anthropic/claude-sonnet-4-5

# Optional vision verifier model. Empty means "same as COMFYCLAW_MODEL".
# COMFYCLAW_VERIFIER_MODEL=

# Verification mode: vlm, human, or hybrid.
COMFYCLAW_VERIFIER_MODE=vlm

# Run mode: manual, auto, or copilot.
COMFYCLAW_RUN_MODE=auto

# ---------------------------------------------------------------------------
# Run behavior
# ---------------------------------------------------------------------------

COMFYCLAW_MAX_ITERATIONS=3
COMFYCLAW_THRESHOLD=0.85
COMFYCLAW_MAX_REPAIR_ATTEMPTS=2

# Optional ComfyUI generation timeout in seconds. Leave 0 for defaults
# (600s image, 2400s video).
COMFYCLAW_GENERATION_TIMEOUT=0

# Verifier score weights as "requirement_weight,detail_weight".
COMFYCLAW_SCORE_WEIGHTS=0.6,0.4

# Pin the ComfyUI checkpoint / UNET name exactly as it appears in ComfyUI.
# COMFYCLAW_IMAGE_MODEL=

# Start each iteration from the best workflow so far.
COMFYCLAW_EVOLVE_FROM_BEST=true

# Build workflows without queueing them into ComfyUI.
COMFYCLAW_DEBUG_NO_GENERATE=false

# ---------------------------------------------------------------------------
# Skills and modalities
# ---------------------------------------------------------------------------

# Optional directory for extra skills.
# COMFYCLAW_SKILLS_DIR=

# Where skills imported from the panel are persisted.
# COMFYCLAW_USER_SKILLS_DIR=~/.comfyclaw/skills

# image or video. The `run-video` and `serve-video` commands force video.
COMFYCLAW_MODALITY=image
COMFYCLAW_VIDEO_FRAMES=6

# ---------------------------------------------------------------------------
# CLI backend binary overrides
# ---------------------------------------------------------------------------

# COMFYCLAW_CLAUDE_BIN=claude
# COMFYCLAW_CODEX_BIN=codex
# COMFYCLAW_GEMINI_BIN=gemini
# COMFYCLAW_GROK_BIN=grok
COMFYCLAW_GROK_SUBSCRIPTION_ONLY=true
